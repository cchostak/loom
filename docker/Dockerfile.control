FROM golang:1.27.0-alpine@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc AS builder
WORKDIR /app
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-w -s" -o /control-plane ./cmd/control-plane
FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
RUN apk --no-cache add ca-certificates curl && mkdir /audit && chown 65532:65532 /audit
COPY --from=builder /control-plane /app/control-plane
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/app/control-plane"]
