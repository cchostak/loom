FROM golang:1.26.8-alpine@sha256:8ac98ca534ac3f51e1f420a1dd2c15e74c75cfa0f23f3ad27eb5d7236c349a0c AS builder
WORKDIR /app
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-w -s" -o /control-plane ./cmd/control-plane
FROM alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8
RUN apk --no-cache add ca-certificates curl && mkdir /audit && chown 65532:65532 /audit
COPY --from=builder /control-plane /app/control-plane
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/app/control-plane"]
