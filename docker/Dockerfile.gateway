FROM ghcr.io/agentgateway/agentgateway:v1.7.0@sha256:60216aafb03d37f94e952ff3d51d2f630a65b10ecaebdc0a864882f92610c45b AS gateway
FROM golang:1.27.3-alpine@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS builder
WORKDIR /src
COPY docker/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-w -s" -o /loom-filesystem ./cmd/filesystem

# Retain upstream's minimal compatible runtime. No shell, curl, Node or npm.
FROM gateway
COPY --from=builder /loom-filesystem /usr/local/bin/loom-filesystem
USER 65532:65532
WORKDIR /workspace
EXPOSE 8080 3000
ENTRYPOINT ["/app/agentgateway"]
CMD ["-f", "/etc/agentgateway/config.yaml"]
