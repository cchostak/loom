FROM ghcr.io/agentgateway/agentgateway:v1.5.0@sha256:bf2f339ef326d32def2aaeb44b1b4549801293c19b89e764a4228667d97d9896 AS gateway
FROM golang:1.26.8-alpine@sha256:8ac98ca534ac3f51e1f420a1dd2c15e74c75cfa0f23f3ad27eb5d7236c349a0c AS builder
WORKDIR /src
COPY docker/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-w -s" -o /loom-filesystem ./cmd/filesystem

# Retain upstream's minimal compatible runtime. No shell, curl, Node or npm.
FROM gateway
COPY --from=builder /loom-filesystem /usr/local/bin/loom-filesystem
USER 65532:65532
WORKDIR /workspace
EXPOSE 8080 3000
ENTRYPOINT ["/app/agentgateway"]
CMD ["-f", "/etc/agentgateway/config.yaml"]
