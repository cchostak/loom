FROM ghcr.io/agentgateway/agentgateway:v1.6.0@sha256:9d3e6044ddcdc0878b1787f77bd401252b95e22684203fb5e874c4c42d2ed90c AS gateway
FROM golang:1.27.1-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS builder
WORKDIR /src
COPY docker/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-w -s" -o /loom-filesystem ./cmd/filesystem

# Retain upstream's minimal compatible runtime. No shell, curl, Node or npm.
FROM gateway
COPY --from=builder /loom-filesystem /usr/local/bin/loom-filesystem
USER 65532:65532
WORKDIR /workspace
EXPOSE 8080 3000
ENTRYPOINT ["/app/agentgateway"]
CMD ["-f", "/etc/agentgateway/config.yaml"]
