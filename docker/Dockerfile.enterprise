FROM golang:1.27.0-alpine@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc AS builder
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-w -s" -o /enterprise ./cmd/enterprise
FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
RUN apk --no-cache add ca-certificates && mkdir /data && chown 65532:65532 /data
COPY --from=builder /enterprise /app/enterprise
USER 65532:65532
ENTRYPOINT ["/app/enterprise"]
