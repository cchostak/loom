FROM golang:1.27.3-alpine@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS builder
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-w -s" -o /enterprise ./cmd/enterprise
FROM alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8
RUN apk --no-cache add ca-certificates && mkdir /data && chown 65532:65532 /data
COPY --from=builder /enterprise /app/enterprise
USER 65532:65532
ENTRYPOINT ["/app/enterprise"]
