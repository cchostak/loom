# ==============================================================================
# Multi-stage Dockerfile for lightweight Go Guardrail Proxy
# ==============================================================================

# Build stage
FROM golang:1.27-alpine AS builder

WORKDIR /app

COPY go.mod ./
COPY main.go ./

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o guardrail main.go

# Minimal runtime stage
FROM alpine:3.24

RUN apk --no-cache add ca-certificates curl

WORKDIR /app

COPY --from=builder /app/guardrail /app/guardrail

EXPOSE 9090

ENTRYPOINT ["/app/guardrail"]
