# ==============================================================================
# Home IDE Powerhouse - Environment Configuration
# ==============================================================================

# OpenRouter API Key for Agentgateway LLM routing
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Web IDE Authentication Password for code-server
IDE_PASSWORD=ide_super_secret_password_change_me

# Optional host port overrides. Change these when another local stack already
# owns a default port; container-to-container ports remain unchanged.
LOOM_LLM_PORT=8080
LOOM_MCP_PORT=3000
LOOM_IDE_PORT=8443
LOOM_GUARDRAIL_PORT=9090
LOOM_JAEGER_PORT=16686
LOOM_OTEL_GRPC_PORT=4317
LOOM_OTEL_HTTP_PORT=4318

# PII scrubbing via Microsoft Presidio (guardrail-proxy → presidio-analyzer sidecar)
# PII_PRESIDIO_URL: URL of the Presidio analyzer service on the internal network.
PII_PRESIDIO_URL=http://presidio-analyzer:5002
# PII_THRESHOLD: Minimum Presidio confidence score (0.0–1.0) to trigger redaction.
PII_THRESHOLD=0.7

# Ingestion Pipeline (profile: pipeline)
# Port for the FastAPI medallion pipeline service.
LOOM_PIPELINE_PORT=8181
# Default LLM model used by the /rag endpoint.
DEFAULT_RAG_MODEL=openai/gpt-4o-mini
