# ==============================================================================
# Git Ignore - Loom Cloud Development & AI Gateway Stack
# ==============================================================================

# Environment files with secrets
.env
!.env.example
*.local.env

# Go build & test artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
cover.out
coverage.out
coverage.html
/docker/guardrail

# Go dependencies
/docker/vendor/

# Node.js artifacts (if local MCP packages installed)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker volumes and local data
.docker-compose.override.yml

# IDE & Editor specific files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Test outputs & temporary files
tmp/
dist/
build/
.cache/

.loom/
__pycache__/

.venv/
.pytest_cache/
.ruff_cache/

/strands-report.json

# Dex OIDC identity stage — generated files (bootstrap_dex.py writes these).
# config/dex.yaml skeleton is tracked; the version with staticClients secrets must not be.
# Use 'git checkout -- config/dex.yaml' to restore the skeleton after 'make dex-clean'.
config/oidc.json
