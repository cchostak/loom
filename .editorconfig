# ==============================================================================
# EditorConfig - Enforce consistent editor styling across teams and IDEs
# http://editorconfig.org
# ==============================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false
max_line_length = 120

[*.sh]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
indent_size = 4
trim_trailing_whitespace = true

[Dockerfile*]
indent_style = space
indent_size = 2
